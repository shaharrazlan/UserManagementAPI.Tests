{
  "MongoSettings": {
    "ConnectionString": "${MONGO_CONNECTION_STRING}",
    "DatabaseName": "${MONGO_DATABASE_NAME}"
  },
  "JwtSettings": {
    "Secret": "${JWT_SECRET}"
  },
  "ClientAppUrl": "${CLIENT_APP_URL}",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
